{$SHOP_DOMAIN} {
  # Deploy-Webhook — nur intern erreichbar über Caddy, kein extra Port nötig
  handle_path /_deploy/* {
    reverse_proxy webhook:9000
  }

  handle {
    reverse_proxy app:3000 {
      # Set X-Real-IP to the actual client address so the app can use it for rate limiting
      # without being spoofed via a client-controlled X-Forwarded-For header
      header_up X-Real-IP {http.request.remote.host}
    }
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
