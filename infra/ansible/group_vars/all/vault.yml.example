# Mit ansible-vault encrypt_string oder ansible-vault edit verschlüsseln.
# Plaintext-Werte hier sind Platzhalter — vor dem ersten Deploy ersetzen.
#
# ansible-vault edit infra/ansible/group_vars/all/vault.yml

vault_db_password: "CHANGE_ME"
vault_smtp_password: "CHANGE_ME"
vault_auth_secret: "CHANGE_ME_MIN_32_CHARS_RANDOM_STRING"
vault_deploy_webhook_secret: "CHANGE_ME_RANDOM_STRING"

# Club-Konfiguration (pro Instanz anpassen)
vault_club_name: "Musterverein e.V."
vault_club_logo_url: "/logo.png"
vault_club_primary_color: "#1a56db"
vault_club_accent_color: "#f59e0b"
vault_club_event_name: "Sommerfest 2025"
vault_club_event_date: "2025-07-12"
vault_club_contact_email: "info@musterverein.de"
vault_cron_secret: "CHANGE_ME"

# GHCR — GitHub PAT mit read:packages Berechtigung
vault_ghcr_token: "REPLACE_ME"

# Monitoring
vault_grafana_admin_password: "CHANGE_ME"
