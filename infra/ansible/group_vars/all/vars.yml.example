deploy_user: shop
app_dir: /opt/shop
data_dir: /mnt/shop-data

# Hier eintragen (nicht sensitive)
shop_domain: "shop.example.de"
smtp_host: "smtp.example.de"
smtp_port: "465"
smtp_secure: "true"
smtp_user: "shop@example.de"
smtp_from: "shop@example.de"

# Hetzner Object Storage — Bucket vorab im Hetzner-Panel anlegen
s3_endpoint: "https://fsn1.your-objectstorage.com"
s3_region: "fsn1"
s3_bucket_name: "shop-assets"
s3_public_url: "https://shop-assets.fsn1.your-objectstorage.com"

# Monitoring — IPs nach terraform apply eintragen
app_server_ip: ""                   # terraform output server_ip
monitoring_server_ip: ""            # terraform output monitoring_ip
monitoring_server_private_ip: ""    # Private-Network-IP des Monitoring-Servers (z.B. 10.0.0.3)
alert_email: "admin@example.de"
