global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: node
    static_configs:
      - targets: ["{{ app_server_private_ip }}:9100"]
        labels:
          instance: shop
      - targets: ["host-gateway:9100"]
        labels:
          instance: monitoring

  - job_name: cadvisor
    static_configs:
      - targets: ["{{ app_server_private_ip }}:8080"]
        labels:
          instance: shop

  - job_name: postgres
    static_configs:
      - targets: ["{{ app_server_private_ip }}:9187"]
        labels:
          instance: shop

  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://{{ shop_domain }}/api/health
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
