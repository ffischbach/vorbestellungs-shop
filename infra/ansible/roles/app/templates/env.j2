DATABASE_URL="postgresql://shop:{{ vault_db_password }}@db:5432/shop"

BETTER_AUTH_SECRET="{{ vault_auth_secret }}"
BETTER_AUTH_URL="https://{{ shop_domain }}"

SMTP_HOST="{{ smtp_host }}"
SMTP_PORT="{{ smtp_port }}"
SMTP_SECURE="{{ smtp_secure }}"
SMTP_USER="{{ smtp_user }}"
SMTP_PASS="{{ vault_smtp_password }}"
SMTP_FROM="{{ smtp_from }}"

CLUB_NAME="{{ vault_club_name }}"
CLUB_LOGO_URL="{{ vault_club_logo_url }}"
CLUB_PRIMARY_COLOR="{{ vault_club_primary_color }}"
CLUB_ACCENT_COLOR="{{ vault_club_accent_color }}"
CLUB_EVENT_NAME="{{ vault_club_event_name }}"
CLUB_EVENT_DATE="{{ vault_club_event_date }}"
CLUB_CONTACT_EMAIL="{{ vault_club_contact_email }}"

SHOP_DOMAIN="{{ shop_domain }}"
DEPLOY_WEBHOOK_SECRET="{{ vault_deploy_webhook_secret }}"
CRON_SECRET="{{ vault_cron_secret }}"

# Hetzner Object Storage (S3-kompatibel)
AWS_ACCESS_KEY_ID="{{ vault_s3_access_key_id }}"
AWS_SECRET_ACCESS_KEY="{{ vault_s3_secret_access_key }}"
S3_ENDPOINT="{{ s3_endpoint }}"
S3_REGION="{{ s3_region }}"
S3_BUCKET_NAME="{{ s3_bucket_name }}"
S3_PUBLIC_URL="{{ s3_public_url }}"
