{
  "name": "vorbestellungsshop",
  "private": true,
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @repo/database migrate",
    "db:migrate:dev": "pnpm --filter @repo/database migrate:dev",
    "db:seed": "pnpm --filter @repo/database seed",
    "db:studio": "pnpm --filter @repo/database studio",
    "db:reset": "pnpm --filter @repo/database reset",
    "db:reset:empty": "pnpm --filter @repo/database reset:empty",
    "email:dev": "pnpm --filter @repo/email dev",
    "admin:create": "pnpm --filter @repo/web admin:create"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
