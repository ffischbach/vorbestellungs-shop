# =============================================================================
# Datenbank
# =============================================================================
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"

# =============================================================================
# Auth (Better Auth)
# =============================================================================
BETTER_AUTH_SECRET="change-me-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# =============================================================================
# E-Mail (SMTP via Nodemailer)
# =============================================================================
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="shop@example.com"

# =============================================================================
# S3-Dateispeicher (optional — nur für Bild- und Logo-Uploads benötigt)
# Kompatibel mit Hetzner Object Storage, MinIO, AWS S3 u.a.
# =============================================================================
# S3_ENDPOINT="https://fsn1.your-objectstorage.com"
# S3_BUCKET_NAME="vorbestellungsshop"
# S3_PUBLIC_URL="https://vorbestellungsshop.fsn1.your-objectstorage.com"
# S3_REGION="fsn1"

# =============================================================================
# Cron / Export Sicherheit
# =============================================================================
# Geheimer Token für alle geschützten API-Endpunkte (Header: x-cron-secret)
CRON_SECRET="change-me-in-production"

# =============================================================================
# Vereinskonfiguration (optional — kann stattdessen über die Admin-UI gesetzt werden)
# Wenn gesetzt, dienen diese Werte als Fallback solange kein DB-Eintrag existiert.
# =============================================================================
# CLUB_NAME="Musterverein e.V."
# CLUB_LOGO_URL="/logo.png"
# CLUB_PRIMARY_COLOR="#1a56db"
# CLUB_ACCENT_COLOR="#f59e0b"
# CLUB_EVENT_NAME="Sommerfest 2025"
# CLUB_EVENT_DATE="2025-07-12"
# CLUB_CONTACT_EMAIL="info@musterverein.de"

# =============================================================================
# Error Tracking (optional — GlitchTip / Sentry-kompatibel)
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
