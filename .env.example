# =============================================================================
# Datenbank
# =============================================================================
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"

# =============================================================================
# Auth (Better Auth)
# =============================================================================
BETTER_AUTH_SECRET="change-me-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# =============================================================================
# E-Mail (SMTP via Nodemailer)
# =============================================================================
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="shop@example.com"

# =============================================================================
# Club-Konfiguration (server-only — wird zur Laufzeit gelesen, nicht zur Build-Zeit)
# Dasselbe Docker-Image läuft für jeden Verein — nur diese Vars anpassen.
# Farben werden als CSS Custom Properties (--color-primary, --color-accent) injiziert.
# =============================================================================
CLUB_NAME="Musterverein e.V."
CLUB_LOGO_URL="/logo.png"
CLUB_PRIMARY_COLOR="#1a56db"
CLUB_ACCENT_COLOR="#f59e0b"
CLUB_EVENT_NAME="Sommerfest 2025"
CLUB_EVENT_DATE="2025-07-12"
CLUB_CONTACT_EMAIL="info@musterverein.de"

# =============================================================================
# Cron / Export Sicherheit
# =============================================================================
# Geheimer Token für alle geschützten API-Endpunkte (Header: x-cron-secret)
CRON_SECRET="change-me-in-production"

# =============================================================================
# Admin-Account anlegen (nur temporär setzen, danach entfernen)
# =============================================================================
# Sign-up ist in Production deaktiviert. Zum Anlegen des ersten Admin-Accounts:
#   1. Zeile einkommentieren + Container neu starten
#   2. ADMIN_EMAIL=... ADMIN_PASSWORD=... pnpm admin:create ausführen
#   3. Zeile wieder auskommentieren + Container neu starten
# ADMIN_SIGNUP_ENABLED=true

# =============================================================================
# Error Tracking (optional — GlitchTip / Sentry-kompatibel)
# =============================================================================
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
